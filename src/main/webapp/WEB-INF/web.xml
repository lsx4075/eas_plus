<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!--全局参数-->
    <context-param>
        <param-name>unChkUrl</param-name>
        <param-value>/Login.jsp,/login</param-value>
    </context-param>

    <welcome-file-list>
        <welcome-file>Login.jsp</welcome-file>
    </welcome-file-list>

    <!--注册filter-->
    <filter>
        <filter-name>encode</filter-name>
        <filter-class>com.jxd.eas.filter.EncodeFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>encode</filter-name>
        <!--匹配所有的后台资源-->
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>logControl</filter-name>
        <filter-class>com.jxd.eas.filter.LoginControlFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>logControl</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>